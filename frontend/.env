GENERATE_SOURCEMAP=false
# ─────────────────────────────────────────────
# frontend/.env
# ─────────────────────────────────────────────

# Leave blank in development — proxy in package.json handles it
# In production set this to your deployed backend URL:
# REACT_APP_API_URL=https://your-backend.com
REACT_APP_API_URL=

# Disables source maps (fixes CSP eval warning from react-scripts)
GENERATE_SOURCEMAP=false

# Optional: your deployed contract address (auto-filled by deploy.js)
REACT_APP_CONTRACT_ADDRESS=
REACT_APP_CHAIN_ID=1337
REACT_APP_RPC_URL=http://127.0.0.1:8545